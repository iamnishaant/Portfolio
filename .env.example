# Copy to .env.local (never commit that file) and fill in.

# --- Contact form (Gmail) --------------------------------------------
# Messages are sent from your Gmail account to your own inbox.
# This must be a Google App Password — NOT your normal Gmail password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character code here (the spaces are fine).
GMAIL_APP_PASSWORD=

# Optional. The Gmail account that sends the messages.
# Defaults to profile.email in src/lib/data.ts (nishant108ns@gmail.com).
GMAIL_USER=

# Optional. Where messages are delivered. Defaults to the same address.
CONTACT_TO_EMAIL=
